{
  "manifest_version": 3,
  "name": "CodeSure – CPT Code Validator",
  "version": "0.6.0",
  "description": "Validate mock 5-digit codes, compare payer rules, suggest codes with AI, translate medical records, and build PA notes using Chrome's built-in AI APIs.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/suggest-worker.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": { "service_worker": "src/background.js" },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-capture.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
